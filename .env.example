# Copy to .env.local (git-ignored) and fill in. Only TYPESAFE_API_KEY is needed to re-run the Jev notebook;
# FMP_API_KEY only to refresh the discount-rate inputs (s1_hurdle.py --refresh). Rebuilding the dashboard needs neither.
TYPESAFE_API_KEY=
FMP_API_KEY=
# SEC asks for a descriptive User-Agent with contact details on EDGAR requests.
EDGAR_IDENTITY="Your Name your.email@example.com"
